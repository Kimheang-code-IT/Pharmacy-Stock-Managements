# Stock & POS — production environment example.
# Copy to `.env` on the production host and replace every CHANGE_ME with a
# strong unique secret. Never commit the filled `.env`.

ENVIRONMENT=production
DEBUG=false

# PostgreSQL (authoritative store for stock, sales, debts, sequences, settings, audit)
POSTGRES_USER=stock_pos
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=stock_pos

# RabbitMQ (Celery broker for exports / telegram queue / scheduled jobs)
RABBITMQ_USER=stock_pos
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_VHOST=stock_pos

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME

# Telegram (password-reset codes; secrets stay server-side, never in the frontend)
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_BOT_MODE=polling
TELEGRAM_BOT_CLIENT_ID=stock-pos-telegram-bot
TELEGRAM_BOT_CLIENT_SECRET=CHANGE_ME

# One-time administrator bootstrap (seed script); change immediately after first login
SEED_ADMIN_EMAIL=CHANGE_ME
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_ADMIN_NAME=System Administrator

# Public browser origins only; the frontend is served over HTTPS behind a reverse proxy.
CORS_ORIGINS=https://CHANGE_ME.example.com
CORS_ALLOW_PRIVATE_NETWORKS=false

# Host port for the nginx frontend container.
FRONTEND_PORT=80

# Product images / shop logos — local disk on the API container (no S3, no MinIO).
LOCAL_STORAGE_DIR=/srv/data/media

# GHCR images (published by CI). Set IMAGE_TAG to a git SHA or version tag.
# IMAGE_REGISTRY=ghcr.io/kimheang-code-it/stock_pos
# IMAGE_TAG=latest
