# Repository root
.env
.env.*
!.env.example
!.env.production.example
!.env.local.example
.production-credentials.txt

# Python / backend caches
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/htmlcov/
**/.coverage
**/.mypy_cache/

# Frontend / Node
**/node_modules/
**/.nuxt/
**/.output/
**/.nitro/
**/.cache/
**/dist/
**/.pnpm-store/

# Playwright e2e artifacts
**/test-results/
**/playwright-report/
**/blob-report/

# Local scratch / tooling
tmp/
.temp/
var/media/
backend/var/
.ruff_cache/
.pytest_cache/
*.log

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Docker / data volumes (never commit)
data/
*.sql.gz

# Database / media backups (never commit)
infrastructure/backups/
backups/
*.dump

# DB cleanup artifacts and service-account keys (may contain secrets)
db_archive/
db.sql
infrastructure/*.json
