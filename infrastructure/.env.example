# Stock & POS — development environment example.
# Copy to `.env` and adjust. Change every value before any real deployment;
# for production use `.env.production.example` instead.

# PostgreSQL (authoritative store for stock, sales, debts, sequences, settings, audit)
POSTGRES_USER=stock_pos
POSTGRES_PASSWORD=stock_pos
POSTGRES_DB=stock_pos

JWT_SECRET_KEY=dev-only-secret-change-me-in-production-0123456789abcdef

# Session lifetime: keep users signed in for 24 hours (1440 minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Telegram (password-reset codes; secrets stay server-side)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_MODE=polling

# Public SPA origin, used to build Telegram password-reset deep links.
FRONTEND_BASE_URL=http://localhost

# One-time administrator bootstrap. Leave disabled so the SPA Initial Setup
# page creates the first administrator; set true to auto-create from these.
SEED_ADMIN_ENABLED=false
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=123456
SEED_ADMIN_NAME=System Administrator

CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80,http://localhost:3000,http://127.0.0.1:3000

# In development, also allow browser origins on private LAN IPs (192.168.x.x, 10.x.x.x, etc.).
CORS_ALLOW_PRIVATE_NETWORKS=true

# Host port for the nginx frontend container (use 3000 if port 80 is unavailable).
FRONTEND_PORT=80

# Host port for the FastAPI service (change if 8100 is taken on this machine).
API_HOST_PORT=8100

# Product images / shop logos — local disk only (no S3, no MinIO).
LOCAL_STORAGE_DIR=var/media

# Image handling. LOCAL-ONLY build (default): images are built from source and
# never pulled from a registry. For prebuilt GHCR images set
# IMAGE_REGISTRY=ghcr.io/kimheang-code-it/stock_pos and PULL_POLICY=pull.
IMAGE_REGISTRY=stock_pos
IMAGE_TAG=local
PULL_POLICY=build
