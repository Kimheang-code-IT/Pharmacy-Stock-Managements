# Stock & POS — LOCAL-ONLY production environment example (Windows PC).
# Copy to `.env` in this `infrastructure/` folder and replace every CHANGE_ME
# with a strong unique secret. Never commit the filled .env.
# Easiest: run infrastructure\scripts\init-env.ps1, which fills strong random
# secrets for you and writes .env automatically.

ENVIRONMENT=production
DEBUG=false

# PostgreSQL (authoritative store for stock, sales, debts, sequences, settings, audit)
POSTGRES_USER=stock_pos
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=stock_pos

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME

# Session lifetime: keep users signed in for 24 hours (1440 minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Telegram (password-reset codes; secrets stay server-side, never in the frontend).
# Leave TELEGRAM_BOT_TOKEN empty to disable Telegram delivery.
TELEGRAM_BOT_TOKEN=

# One-time administrator bootstrap (seed script); change immediately after first login
SEED_ADMIN_EMAIL=CHANGE_ME
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_ADMIN_NAME=System Administrator

# Same-origin localhost frontend. CORS_ALLOW_PRIVATE_NETWORKS must stay false in production.
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80
CORS_ALLOW_PRIVATE_NETWORKS=false

# Frontend host binding.
# 127.0.0.1 = this PC only (default). For LAN access later set e.g. FRONTEND_BIND=192.168.1.50
# (or 0.0.0.0 for all interfaces — only on a trusted network).
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=80

# Product images / shop logos — local disk on the API container (no S3, no MinIO).
LOCAL_STORAGE_DIR=/srv/data/media

# Scheduler inside the FastAPI process (never a separate container).
SCHEDULER_ENABLED=true

# Image handling for the client PC.
# - Built from source once with the install script (no GHCR login needed).
# - Or load exported image archives (see infrastructure/README.md, "Upgrade").
# IMAGE_TAG=local
# PULL_POLICY=build

# Optional: pin the Compose project name. Leave unset for the default (stock_pos)
# which keeps container/volume names stable. Set to `stockmanagement` only if you
# need to reuse volumes created by an older checkout.
# COMPOSE_PROJECT_NAME=stock-management