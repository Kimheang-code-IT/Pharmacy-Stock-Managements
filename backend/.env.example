# Stock & POS backend — local (non-Docker) environment example.
# Docker Compose sets the same values inline; this file is for running uvicorn
# or pytest directly on the host.

DATABASE_URL=postgresql+asyncpg://stock_pos:stock_pos@localhost:55432/stock_pos
REDIS_URL=redis://localhost:56379/0

JWT_SECRET_KEY=dev-only-secret-change-me-in-production-0123456789abcdef

# Session lifetime: keep users signed in for 24 hours (1440 minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_MODE=polling

# Public SPA origin, used to build Telegram password-reset deep links.
FRONTEND_BASE_URL=http://localhost:3000

SEED_ADMIN_ENABLED=false
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=123456
SEED_ADMIN_NAME=System Administrator

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_PRIVATE_NETWORKS=true

# Product images / shop logos — local disk only (no S3, no MinIO).
LOCAL_STORAGE_DIR=var/media
