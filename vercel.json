{
  "version": 2,
  "framework": null,
  "installCommand": "corepack enable && corepack prepare pnpm@10.30.3 --activate && pnpm --dir frontend install --frozen-lockfile",
  "buildCommand": "pnpm --dir frontend build",
  "outputDirectory": "frontend/.output/public",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "env": {
    "NUXT_PUBLIC_USE_MOCK_DATA": "true",
    "NUXT_PUBLIC_API_BASE": "same-origin",
    "NUXT_PUBLIC_SITE_URL": "https://frontend-phi-blush-58.vercel.app"
  },
  "build": {
    "env": {
      "NUXT_PUBLIC_USE_MOCK_DATA": "true",
      "NUXT_PUBLIC_API_BASE": "same-origin",
      "NUXT_PUBLIC_SITE_URL": "https://frontend-phi-blush-58.vercel.app"
    }
  }
}
