# Backend origin for API calls.
# Use `auto` (default) to follow the page hostname on port 8000 — required for
# phones/tablets on the same Wi‑Fi (e.g. http://192.168.1.10:3000 → :8000).
# Set an explicit URL when the API is on another host or port.
# Docker nginx proxies `/api` to the backend — use same-origin in production stacks.
# Local dev without Docker can keep `auto` (hostname:8000).
NUXT_PUBLIC_API_BASE=same-origin

# Server-side API origin for local tooling; the static Docker frontend calls the public API directly.
# NUXT_API_INTERNAL_BASE=http://127.0.0.1:8000
NUXT_PUBLIC_API_TIMEOUT_MS=30000

# Real API mode uses bearer JWT authentication (access + rotating refresh
# tokens). The backend intentionally does not implement cookie sessions or CSRF.
NUXT_PUBLIC_AUTH_MODE=bearer
NUXT_PUBLIC_CSRF_COOKIE_NAME=XSRF-TOKEN
NUXT_PUBLIC_CSRF_HEADER_NAME=X-CSRF-Token

# Mock UI (no Docker / backend required). Default is mock ON unless set to false.
# For Vercel demo without API, keep true (or omit). Flip to false when API is ready.
NUXT_PUBLIC_USE_MOCK_DATA=true

# Real API mode uses bearer JWT authentication (access + rotating refresh
# tokens). The backend intentionally does not implement cookie sessions or CSRF.
NUXT_PUBLIC_AUTH_MODE=bearer
NUXT_PUBLIC_CSRF_COOKIE_NAME=XSRF-TOKEN
NUXT_PUBLIC_CSRF_HEADER_NAME=X-CSRF-Token

# Optional build/deploy version shown in the application UI.
NUXT_PUBLIC_APP_VERSION=0.1.0

# Public site origin (no trailing slash) for Open Graph / Twitter image URLs.
# Required so Telegram/WhatsApp/Facebook can load preview images when links are shared.
# In production set this to your real HTTPS domain. On SSR, request origin is used as fallback.
# NUXT_PUBLIC_SITE_URL=https://app.example.com
